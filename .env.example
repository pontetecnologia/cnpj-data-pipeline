# CNPJ Data Pipeline Configuration

# Database (PostgreSQL via Docker on port 5435)
DATABASE_URL=postgres://postgres:postgres@localhost:5435/cnpj
# Query-string params are passed through to libpq (sslmode, options, application_name, connect_timeout, ...).
# Examples:
#   DATABASE_URL=postgres://user:pass@host:5432/cnpj?sslmode=require
#   DATABASE_URL=postgres://user:pass@host:5432/cnpj?sslmode=require&options=-c%20search_path%3Dcnpj

# Processing
BATCH_SIZE=500000
TEMP_DIR=./temp

# Downloads (parallel)
DOWNLOAD_WORKERS=4

# Processing (parallel): files within the same dependency group
PROCESS_WORKERS=1

# Network
# RETRY_ATTEMPTS counts CONSECUTIVE failures without forward progress: a retry
# that adds bytes to the .part file resets it, so a large file can survive many
# productive stalls. RETRY_DELAY is the base for exponential backoff on
# no-progress failures (doubles each time, capped at 120s).
RETRY_ATTEMPTS=3
RETRY_DELAY=5
CONNECT_TIMEOUT=30
READ_TIMEOUT=300
STALL_TIMEOUT=30
PROGRESS_LOG_INTERVAL=30
# Cumulative stalls (or connect timeouts) at which download concurrency
# degrades one step (DOWNLOAD_WORKERS -> 2 -> 1) for the rest of the run.
STALL_DEGRADE_THRESHOLD=3

# Loading strategy: "upsert" (default, keeps availability) or "replace" (faster, truncates tables)
LOADING_STRATEGY=upsert

# Receita Federal WebDAV (override se URL mudar)
# BASE_URL=https://arquivos.receitafederal.gov.br/public.php/webdav
# SHARE_TOKEN=YggdBLfdninEJX9

# Cleanup
KEEP_DOWNLOADED_FILES=false

# ─── Prospecção GestaoRevenda (filtro.py / exportar_prospeccao.py) ──────────
# Desligado = comportamento original do pipeline (carga completa).
PROSPECCAO_FILTRO=false
# Situação cadastral (02 = ativa). Vários: 02,03
FILTRO_SITUACAO=02
# CNAEs principais (aceita 4711-3/02 ou 4711302), separados por vírgula
FILTRO_CNAES=4711-3/02,4712-1/00,4711-3/01,4744-0/99,4744-0/01,4530-7/03,4789-0/04
# UF (sigla). Vazio = todas
FILTRO_UF=
# Municípios: código da Receita (NÃO é o do IBGE) ou nome como a Receita grafa, separados por ; ou ,
# Ex.: FILTRO_MUNICIPIOS=JOINVILLE;JARAGUA DO SUL;8179
FILTRO_MUNICIPIOS=
# Início de atividade nos últimos N meses. 0 = sem limite (primeira carga: traz todas as ativas)
FILTRO_INICIO_ATIVIDADE_MESES=12
# Estado local do que já foi enviado ao GestaoRevenda (SQLite)
PROSPECCAO_ESTADO=estado/prospeccao.sqlite
# Primeira execução do rodar_mensal (estado local vazio): janela de início de atividade em meses.
# 0 = todas as ativas da região. Nas execuções seguintes vale FILTRO_INICIO_ATIVIDADE_MESES.
FILTRO_PRIMEIRA_EXECUCAO_MESES=0
PROSPECCAO_LOGS=logs

# ─── Envio ao GestaoRevenda (enviar_gestaorevenda.py) ───────────────────────
# Base da API COM /api. Client ID/Secret: GestaoRevenda > Configurações > API Externa, escopo "leads".
GR_API_URL=
GR_CLIENT_ID=
GR_CLIENT_SECRET=
GR_LOTE=200
GR_TENTATIVAS=4
GR_TIMEOUT=300
# true = o GestaoRevenda também consulta cada CNPJ na cnpja.com (4/min — muito lento para lotes grandes)
GR_ENFILEIRAR_CNPJA=false
