# CNPJ Data Pipeline — prospecção GestaoRevenda (serviço "Ponte - Prospecção Receita")
#
# Aqui ficam SÓ as credenciais do API Client do GestaoRevenda. Todo o resto (envio ligado/desligado,
# CNAEs, UF, municípios, situação, data de abertura, horário da verificação, disco mínimo e e-mails do
# aviso) é configurado no GestaoRevenda: Configurações → Prospecção Receita.
#
# Base da API COM /api. Client ID/Secret: GestaoRevenda → Configurações → API Externa, com os escopos
# "leads", "prospeccao-config" e "prospeccao-execucoes".
GR_API_URL=
GR_CLIENT_ID=
GR_CLIENT_SECRET=

# ─── Opcional: pipeline original (main.py / docker compose, sem o serviço) ──────
# Os padrões estão em config.py; descomente só o que precisar mudar.
# DATABASE_URL=postgres://postgres:postgres@localhost:5435/cnpj
#   Query-string params are passed through to libpq (sslmode, options, application_name, ...):
#   DATABASE_URL=postgres://user:pass@host:5432/cnpj?sslmode=require
# OUTPUT_FORMAT=postgres            # o serviço usa parquet (padrão no rodar_mensal)
# BATCH_SIZE=500000
# TEMP_DIR=./temp
# DOWNLOAD_WORKERS=4
# PROCESS_WORKERS=1
# RETRY_ATTEMPTS counts CONSECUTIVE failures without forward progress: a retry that adds bytes to
# the .part file resets it. RETRY_DELAY is the base for exponential backoff (capped at 120s).
# RETRY_ATTEMPTS=3
# RETRY_DELAY=5
# CONNECT_TIMEOUT=30
# READ_TIMEOUT=300
# STALL_TIMEOUT=30
# PROGRESS_LOG_INTERVAL=30
# STALL_DEGRADE_THRESHOLD=3
# LOADING_STRATEGY=upsert           # ou replace (mais rápido, trunca as tabelas)
# KEEP_DOWNLOADED_FILES=false
# Receita Federal WebDAV (override se a URL mudar)
# BASE_URL=https://arquivos.receitafederal.gov.br/public.php/webdav
# SHARE_TOKEN=YggdBLfdninEJX9
# Filtro de prospecção no main.py direto (o serviço usa o da tela):
# PROSPECCAO_FILTRO=true
# FILTRO_CNAES=4711-3/02,4712-1/00
# FILTRO_UF=SC
# FILTRO_MUNICIPIOS=JOINVILLE;JARAGUA DO SUL
